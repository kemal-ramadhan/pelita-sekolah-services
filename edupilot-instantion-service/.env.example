# Server
APP_PORT=8080
APP_ENV=development

# Rate Limiting
RATE_LIMIT_ENABLED=true

# CORS (comma-separated allowlist)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database
DB_HOST=db_auth
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=edupilot_instantion_db
DB_PORT=5432

# Redis (shared with auth-service for token revocation)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT (must match auth-service; HS256, access tokens only). Required.
JWT_SECRET=change-me

# Security
# must match edupilot-gateway
GATEWAY_SECRET=change-me
# must match auth-service
INTERNAL_SERVICE_SECRET=change-me
AUTH_SERVICE_INTERNAL_URL=http://auth-service:8080

# Tracer
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
