# Server
APP_PORT=8080
# "production" enables release mode, Secure cookies, hides /docs
APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Student app: links in reset/activation emails of student accounts (default http://localhost:5175)
STUDENT_FRONTEND_URL=http://localhost:5175

# Rate limiting (set to "false" to disable)
RATE_LIMIT_ENABLED=true

# Database
DB_HOST=db_auth
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=edupilot_auth_db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (seconds). JWT_SECRET is required; the service refuses to start without it.
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES=86400
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URL=http://localhost:8888/auth/google/callback
# empty = host-only cookie
COOKIE_DOMAIN=

# Security
BCRYPT_COST=12
# when set, requests must carry X-Gateway-Auth
GATEWAY_SECRET=change-me
# X-Internal-Secret for /internal/*; empty = /internal returns 503
INTERNAL_SERVICE_SECRET=change-me
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Seed super_admin (skipped if unset or the email already exists)
SEED_ADMIN_EMAIL=admin@edupilot.local
SEED_ADMIN_PASSWORD=change-me-min-8-chars

# Tracing / metrics
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_SERVICE_NAME=edupilot-auth-service
PROMETHEUS_PATH=/metrics

# Mailing
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="EduPilot"

# Teacher invite activation link validity (hours)
ACTIVATION_TOKEN_TTL_HOURS=72
