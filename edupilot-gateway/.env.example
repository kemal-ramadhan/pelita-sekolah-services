APP_ENV=development
PORT=80

DB_HOST=db_auth
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=edupilot_gateway_db

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
AUDIT_LOG_QUEUE=audit_logs_queue
AUDIT_LOG_DLX=audit_logs_dlx
AUDIT_LOG_DLQ=audit_logs_dlq
RABBITMQ_PREFETCH=20

# Optional request-log pool tuning
REQUEST_LOG_BUFFER=1024
REQUEST_LOG_WORKERS=4

AUTH_SERVICE_URL=http://auth-service:8080
INSTANTION_SERVICE_URL=http://instantion-service:8080
ASSESSMENT_SERVICE_URL=http://edupilot-assesment:8080

# Required. Must equal GATEWAY_SECRET in auth-service and instantion-service.
GATEWAY_SECRET=

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
