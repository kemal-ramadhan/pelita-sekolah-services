{
  "code": "PMK",
  "name": "Tes Penelusuran Minat Karier Holland",
  "version": "1.0.0",
  "instructions": "Asesmen ini menggunakan 4 bagian penelusuran diri: Aktivitas, Kompetensi, Pekerjaan, dan Estimasi Diri. Jawablah sesuai kecenderungan dan penilaian dirimu.",
  "duration_minutes": 20,
  "has_timer": false,
  "parts": {
    "part_a": {
      "title": "Bagian A – Aktivitas",
      "instruction": "Tandai SUKA bila kamu menyukai kegiatan ini, TIDAK bila tidak.",
      "items": [
        {"id": "PMK-A-R1", "type": "R", "text": "Memperbaiki barang yang rusak"},
        {"id": "PMK-A-R2", "type": "R", "text": "Bekerja dengan alat atau mesin"},
        {"id": "PMK-A-R3", "type": "R", "text": "Berkegiatan di alam terbuka"},
        {"id": "PMK-A-I1", "type": "I", "text": "Melakukan percobaan atau penelitian"},
        {"id": "PMK-A-I2", "type": "I", "text": "Memecahkan soal sulit dengan logika"},
        {"id": "PMK-A-I3", "type": "I", "text": "Membaca topik sains atau teknologi"},
        {"id": "PMK-A-A1", "type": "A", "text": "Menggambar atau mendesain"},
        {"id": "PMK-A-A2", "type": "A", "text": "Menulis kreatif atau bermusik"},
        {"id": "PMK-A-A3", "type": "A", "text": "Membuat konten visual atau tampil di panggung"},
        {"id": "PMK-A-S1", "type": "S", "text": "Membantu orang menyelesaikan masalahnya"},
        {"id": "PMK-A-S2", "type": "S", "text": "Mengajar atau membimbing orang lain"},
        {"id": "PMK-A-S3", "type": "S", "text": "Berkegiatan sosial/relawan"},
        {"id": "PMK-A-E1", "type": "E", "text": "Memimpin tim"},
        {"id": "PMK-A-E2", "type": "E", "text": "Meyakinkan atau menjual sesuatu"},
        {"id": "PMK-A-E3", "type": "E", "text": "Mengorganisir acara atau usaha"},
        {"id": "PMK-A-C1", "type": "C", "text": "Mengatur data atau arsip dengan rapi"},
        {"id": "PMK-A-C2", "type": "C", "text": "Menghitung dan mencatat keuangan"},
        {"id": "PMK-A-C3", "type": "C", "text": "Mengikuti prosedur secara teliti"}
      ]
    },
    "part_b": {
      "title": "Bagian B – Kompetensi",
      "instruction": "Tandai BISA bila kamu merasa dapat melakukan ini dengan baik, BELUM bila belum.",
      "items": [
        {"id": "PMK-B-R1", "type": "R", "text": "Memakai obeng/bor atau alat sederhana dengan aman"},
        {"id": "PMK-B-R2", "type": "R", "text": "Membaca petunjuk perakitan dan merakit sesuatu"},
        {"id": "PMK-B-R3", "type": "R", "text": "Merawat tanaman atau hewan"},
        {"id": "PMK-B-I1", "type": "I", "text": "Merancang percobaan sederhana"},
        {"id": "PMK-B-I2", "type": "I", "text": "Menafsirkan grafik atau tabel data"},
        {"id": "PMK-B-I3", "type": "I", "text": "Menjelaskan alasan ilmiah suatu fenomena"},
        {"id": "PMK-B-A1", "type": "A", "text": "Menggambar/mendesain sesuatu yang dinilai bagus oleh orang lain"},
        {"id": "PMK-B-A2", "type": "A", "text": "Menulis cerita atau puisi yang orisinal"},
        {"id": "PMK-B-A3", "type": "A", "text": "Memainkan alat musik, menari, atau berakting"},
        {"id": "PMK-B-S1", "type": "S", "text": "Mendengarkan dan menenangkan teman yang sedih"},
        {"id": "PMK-B-S2", "type": "S", "text": "Menjelaskan pelajaran kepada teman hingga ia paham"},
        {"id": "PMK-B-S3", "type": "S", "text": "Bekerja sama dengan orang yang berbeda sifat"},
        {"id": "PMK-B-E1", "type": "E", "text": "Berbicara di depan kelas dengan percaya diri"},
        {"id": "PMK-B-E2", "type": "E", "text": "Membagi tugas dan memotivasi anggota kelompok"},
        {"id": "PMK-B-E3", "type": "E", "text": "Menawarkan atau menawar sesuatu secara meyakinkan"},
        {"id": "PMK-B-C1", "type": "C", "text": "Membuat tabel/spreadsheet sederhana"},
        {"id": "PMK-B-C2", "type": "C", "text": "Menyusun jadwal dan menaatinya"},
        {"id": "PMK-B-C3", "type": "C", "text": "Memeriksa tulisan/hitungan hingga bebas kesalahan"}
      ]
    },
    "part_c": {
      "title": "Bagian C – Pekerjaan",
