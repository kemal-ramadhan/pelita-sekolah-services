        {"id": "PMK-C-R3", "type": "R", "text": "Teknisi listrik/elektronik"},
        {"id": "PMK-C-I1", "type": "I", "text": "Peneliti/ilmuwan"},
        {"id": "PMK-C-I2", "type": "I", "text": "Dokter"},
        {"id": "PMK-C-I3", "type": "I", "text": "Analis data/programmer"},
        {"id": "PMK-C-A1", "type": "A", "text": "Desainer grafis/animator"},
        {"id": "PMK-C-A2", "type": "A", "text": "Penulis/sutradara"},
        {"id": "PMK-C-A3", "type": "A", "text": "Musisi/seniman"},
        {"id": "PMK-C-S1", "type": "S", "text": "Guru"},
        {"id": "PMK-C-S2", "type": "S", "text": "Perawat/psikolog"},
        {"id": "PMK-C-S3", "type": "S", "text": "Pekerja sosial"},
        {"id": "PMK-C-E1", "type": "E", "text": "Pengusaha"},
        {"id": "PMK-C-E2", "type": "E", "text": "Manajer/pemimpin organisasi"},
        {"id": "PMK-C-E3", "type": "E", "text": "Pemasar (marketing)"},
        {"id": "PMK-C-C1", "type": "C", "text": "Akuntan"},
        {"id": "PMK-C-C2", "type": "C", "text": "Staf administrasi/perbankan"},
        {"id": "PMK-C-C3", "type": "C", "text": "Auditor/petugas pajak"}
      ]
    },
    "part_d": {
      "title": "Bagian D – Estimasi Diri",
