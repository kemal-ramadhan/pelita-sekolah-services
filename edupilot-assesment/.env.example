APP_ENV=development
PORT=8080
SERVICE_NAME=edupilot-assesment

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=edupilot_assesment_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ASSESSMENT_QUEUE=assessment_submissions_queue
ASSESSMENT_WORKERS=4

# Required (service refuses to start without JWT_SECRET). Must equal auth-service.
JWT_SECRET=
# Required. Must equal GATEWAY_SECRET of the gateway and instantion-service: it authenticates
# gateway → assessment traffic AND assessment → instantion /internal/assessment/* calls.
GATEWAY_SECRET=
# instantion-service base URL on the docker network (internal routes, contract §13.1).
INSTANTION_INTERNAL_URL=http://instantion-service:8080

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
